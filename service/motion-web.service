[Unit]
Description=Veb prikaz sistema za detekciju prisustva
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vcoca
WorkingDirectory=/home/vcoca/motion-camera
ExecStart=/usr/bin/python3 /home/vcoca/motion-camera/app.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
